# Copy to .env and fill in. NEVER commit .env.
# Variable names only; no real values here.

# Identifies the trial machine in every DB row (e.g. "laptop-harini"). Falls back to hostname.
RMC_MACHINE_ID=

# Network interface for netem on THIS machine (find it with: ip route get 8.8.8.8 -> "dev ...").
RMC_NETEM_INTERFACE=

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RMC_S3_BUCKET=

# --- Google Cloud Storage ---
# Path to a service-account JSON key stored OUTSIDE the repository.
GOOGLE_APPLICATION_CREDENTIALS=
RMC_GCS_PROJECT=
RMC_GCS_BUCKET=

# --- Backblaze B2 ---
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
RMC_B2_BUCKET=
